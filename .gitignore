# Virtual environment
eeg_bci_env/

# ---------------------------------------------------------------
# Participant EEG recordings — NEVER commit.
# This is a public repository and the recordings are personal data
# collected under informed consent for the study, not for release.
# ---------------------------------------------------------------
*.fif
*.csv
eeg_data/markers_*.json
eeg_data/exports/
eeg_data/για_καθηγητη/

# Generated figures — regenerable from the scripts, and the per-participant
# ones are hundreds of MB. Only the two group-level summaries used in the
# README are tracked (see the negations below).
eeg_data/figures/*
!eeg_data/figures/thesis/
eeg_data/figures/thesis/*
!eeg_data/figures/thesis/fig_loro_summary.png
!eeg_data/figures/thesis/fig_kfold_vs_loro.png

# Trained model binaries (reproducible by running the pipeline)
eeg_data/models/*.joblib

# Claude Code local settings
.claude/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# macOS
.DS_Store

# Jupyter
.ipynb_checkpoints/

# Logs
*.log

# Built page — the published copy lives in docs/index.html
site/thesis-site.html

# ---------------------------------------------------------------
# Per-trial participant waveforms exported for the site demo.
# Same rule as the recordings above: personal data, not for release.
# Regenerate locally with:
#   ./eeg_bci_env/bin/python site/export_demo.py site/assets/demo_data.json S11,S01,S02
# To publish them deliberately, read site/DATA_NOTICE.md first, then
#   python3 site/build_site.py --pages --with-trials && git add -f docs/demo_data.json
# ---------------------------------------------------------------
site/assets/demo_data.json
docs/demo_data.json
